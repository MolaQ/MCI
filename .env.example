# ---------------------------------------------------------------------------
# SOWA — Szkolny Ośrodek Wiadomości i Alarmowania
# Default profile: shared PHP hosting (PHP 8.3 + MySQL + cron).
# See docs/DEPLOYMENT.md for the VPS profile (Redis, Supervisor, Reverb).
# ---------------------------------------------------------------------------
APP_NAME=SOWA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
# Minutes a password set-up / reset link stays valid.
AUTH_PASSWORD_LINK_EXPIRE=1440

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mci
DB_USERNAME=mci
DB_PASSWORD=
# Demo mode (Witryna → Tryb demo): separate database, name must contain "demo".
# Empty = <DB_DATABASE>_demo. Never point it at the production database.
DB_DEMO_DATABASE=
MCI_DEMO_ADMIN_EMAIL=demo@example.edu.pl
MCI_DEMO_ADMIN_PASSWORD=demo12345

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Shared hosting: no WebSockets. Live views use Livewire polling.
# VPS: set BROADCAST_CONNECTION=reverb and MCI_REALTIME=broadcast.
BROADCAST_CONNECTION=log
MCI_REALTIME=poll
MCI_POLL_SECONDS=5
MCI_FEED_POLL_SECONDS=20
# To-Do reminders: minutes before the due time (timed / all-day tasks)
MCI_TASK_REMIND_MINUTES=60
MCI_TASK_REMIND_MINUTES_ALL_DAY=1440
# Largest image a user may upload (KB). PHP's upload_max_filesize/post_max_size must allow it.
MCI_MEDIA_MAX_UPLOAD_KB=8192

FILESYSTEM_DISK=local

# Shared hosting: database queue drained by the scheduler (cron every minute).
# VPS: QUEUE_CONNECTION=redis + Supervisor and MCI_QUEUE_VIA_SCHEDULER=false.
QUEUE_CONNECTION=database
MCI_QUEUE_VIA_SCHEDULER=true
MCI_QUEUE_MAX_TIME=50

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="mci@example.edu.pl"
MAIL_FROM_NAME="${APP_NAME}"

# First school, created by `php artisan db:seed` on a fresh install (more schools: Administracja witryny → Szkoły).
MCI_SCHOOL_NAME="Zespół Szkół Mechanicznych"
MCI_SCHOOL_SHORT_NAME=ZSM
MCI_SCHOOL_SLUG=zsm
# Comma-separated; self-registration through group QR codes is limited to these domains (empty = any).
MCI_SCHOOL_EMAIL_DOMAINS=

# Invites / QR codes
MCI_INVITE_DEFAULT_DAYS=14
MCI_INVITE_MAX_DAYS=365
MCI_SIGNUP_VERIFICATION_HOURS=48

# First administrator (site admin + school admin of the first school), created by `php artisan db:seed` (change the password after first login).
MCI_ADMIN_EMAIL=admin@example.edu.pl
MCI_ADMIN_PASSWORD=
MCI_ADMIN_FIRST_NAME=Administrator
MCI_ADMIN_LAST_NAME=MCI

# Web Push. Generate once with `php artisan webpush:vapid` and keep them: new keys
# invalidate every device subscription. Empty = push is not offered.
VAPID_SUBJECT="mailto:mci@example.edu.pl"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
